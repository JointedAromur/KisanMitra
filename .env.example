# Server Configuration
PORT=5000
NODE_ENV=development

# OpenWeatherMap API Key (Get from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AI Vision API (e.g., Google Gemini or OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Bhashini / Indian Language Voice STT/TTS API
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id_here

# Agmarknet / Mandi Market Data API (data.gov.in)
AGMARKNET_API_KEY=your_agmarknet_api_key_here
